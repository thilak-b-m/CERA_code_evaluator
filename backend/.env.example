NODE_ENV=development
PORT=3000
# Local development origins. In production add your Vercel URL, e.g.:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,https://<your-app>.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
MONGODB_URI=mongodb+srv://<username>:<db_password>@<cluster>.mongodb.net/
MONGODB_DB_NAME=cera
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<generate-a-random-secret-of-at-least-32-bytes>
# Code execution requires a Docker daemon and pre-pulled official runtime images.
# DOCKER_BIN=C:\Program Files\Docker\Docker\resources\bin\docker.exe
# Optional DNS server override for environments where Node cannot resolve Atlas SRV records.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
# Local AI evaluation uses these defaults; set a different URL only if Ollama is elsewhere.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5-coder:14b
# Ollama grading timeout in milliseconds (default 300000; allowed 30000-900000).
# OLLAMA_TIMEOUT_MS=300000
# Retry transient Ollama failures once by default; 0 disables retry (allowed 0-3).
# OLLAMA_RETRY_LIMIT=1
# Delay between transient retries in milliseconds (default 3000; allowed 500-30000).
# OLLAMA_RETRY_DELAY_MS=3000
